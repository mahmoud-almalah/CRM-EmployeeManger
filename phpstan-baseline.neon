parameters:
	ignoreErrors:
		-
			message: '#^Call to an undefined method Application\\Bus\\Query\\Query\:\:getWith\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Application/User/QueriesHandlers/GetAllUsersQueryHandler.php

		-
			message: '#^Called ''Model\:\:make\(\)'' which performs unnecessary work, use ''new Model\(\)''\.$#'
			identifier: larastan.noModelMake
			count: 1
			path: src/Infrastructure/User/Persistence/Repositories/UserRepository.php
